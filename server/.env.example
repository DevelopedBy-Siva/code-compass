LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_LLM_MODEL=qwen.qwen3-coder-next

# Both retrieval models run locally in 4-bit NF4. The first launch downloads
# their weights from Hugging Face.
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
QWEN_RERANKER_MODEL=Qwen/Qwen3-Reranker-4B
QWEN_DEVICE_MAP=auto
QWEN_COMPUTE_DTYPE=float16
EMBEDDING_BATCH_SIZE=2
RERANKER_BATCH_SIZE=2
QWEN_EMBEDDING_MAX_LENGTH=8192
QWEN_RERANKER_MAX_LENGTH=8192

CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=repo_qa_chunks
CHROMA_UPSERT_BATCH_SIZE=64
