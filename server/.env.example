APP_ENV=local
LOG_LEVEL=INFO
PORT=8080
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=qwen.qwen3-coder-next
QDRANT_URL=https://your-cluster.us-east.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=replace-for-local-development
# In AWS, prefer QDRANT_API_KEY_SECRET_ARN over QDRANT_API_KEY.
# QDRANT_API_KEY_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:qdrant-api-key
QDRANT_COLLECTION=code_compass_qwen3_embedding_0_6b_last_token_cache_v2
QDRANT_UPSERT_BATCH_SIZE=64
QDRANT_TIMEOUT_SECONDS=60
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_MINUTES=120
REPO_CACHE_DIR=/tmp/codecompass-repos
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
QWEN_EMBEDDING_BATCH_SIZE=8
RERANKER_MODEL_ID=Qwen/Qwen3-Reranker-0.6B
RAG_RERANK_BATCH_SIZE=4
RAG_FINAL_SOURCE_LIMIT=8
RAG_SEARCH_MULTIPLIER=4
RAG_DEEP_SEARCH_MULTIPLIER=8
